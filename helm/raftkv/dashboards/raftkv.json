{
  "title": "raftkv",
  "uid": "raftkv-overview",
  "schemaVersion": 38,
  "tags": [
    "raftkv",
    "raft"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Cluster leader",
      "id": 1,
      "targets": [
        {
          "expr": "raftkv_raft_role == 2",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Term",
      "id": 2,
      "targets": [
        {
          "expr": "raftkv_raft_term",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commit / Applied indices",
      "id": 3,
      "targets": [
        {
          "expr": "raftkv_raft_commit_index",
          "refId": "A"
        },
        {
          "expr": "raftkv_raft_applied_index",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Client request p99 latency (ms)",
      "id": 4,
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.99, rate(raftkv_client_request_duration_seconds_bucket[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Election count",
      "id": 5,
      "targets": [
        {
          "expr": "rate(raftkv_raft_elections_total[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}
